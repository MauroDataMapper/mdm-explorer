{
  "name": "mdm-explorer",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "generators": {
    "@schematics/angular:component": {
      "style": "scss"
    },
    "@schematics/angular:application": {
      "strict": true
    }
  },
  "sourceRoot": "apps/mdm-explorer/src",
  "prefix": "mdm",
  "targets": {
    "build": {
      "executor": "@angular-builders/custom-webpack:browser",
      "options": {
        "customWebpackConfig": {
          "path": "webpack.config.js"
        },
        "outputPath": "dist/mdm-explorer",
        "index": "apps/mdm-explorer/src/index.html",
        "main": "apps/mdm-explorer/src/main.ts",
        "polyfills": "apps/mdm-explorer/src/polyfills.ts",
        "tsConfig": "tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/mdm-explorer/src/assets/favicon.ico",
          "apps/mdm-explorer/src/assets",
          {
            "glob": "open-id-connect-redirect.html",
            "input": "src/static-pages",
            "output": "/redirects"
          }
        ],
        "styles": [
          "apps/mdm-explorer/src/styles.scss",
          "node_modules/@fortawesome/fontawesome-free/css/all.css",
          "node_modules/primeng/resources/primeng.min.css"
        ],
        "scripts": [],
        "preserveSymlinks": true
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "80kb",
              "maximumError": "100kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/mdm-explorer/src/environments/environment.ts",
              "with": "apps/mdm-explorer/src/environments/environment.prod.ts"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": {
            "scripts": true,
            "styles": true,
            "vendor": true
          },
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "browserTarget": "mdm-explorer:build:production"
        },
        "development": {
          "browserTarget": "mdm-explorer:build:development"
        }
      },
      "defaultConfiguration": "development",
      "options": {
        "port": 4201
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "browserTarget": "mdm-explorer:build"
      }
    },
    "test": {
      "executor": "@angular-builders/jest:run",
      "options": {
        "tsConfig": "tsconfig.spec.json",
        "polyfills": ["zone.js", "zone.js/testing"]
      }
    }
  }
}
